{
  "name": "sprintmark",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Local-first, file-backed project and sprint tracker",
  "license": "Apache-2.0",
  "author": "Muhammet Gülhan",
  "repository": {
    "type": "git",
